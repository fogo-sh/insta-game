{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One stoppable shared game host; persistent gp3 only while asleep",
  "Parameters": {
    "OperatorCIDR": {
      "Type": "String",
      "Description": "Operator public IPv4 CIDR for SSH and controller HTTPS"
    },
    "GameCIDR": {
      "Type": "String",
      "Default": "0.0.0.0/0",
      "Description": "Allowed player or gateway public IPv4 CIDR for game TCP and UDP"
    },
    "PublicKey": {
      "Type": "String",
      "Description": "Existing SSH public key (private key stays on operator machine)"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3a.micro",
      "AllowedPattern": "t(3a?|4g)\\.(micro|small|medium|large|xlarge|2xlarge)"
    },
    "DiskGiB": {
      "Type": "Number",
      "Default": 8,
      "MinValue": 8,
      "MaxValue": 256
    },
    "UDPFrom": {
      "Type": "Number",
      "Default": 32768,
      "MinValue": 1,
      "MaxValue": 65535
    },
    "UDPTo": {
      "Type": "Number",
      "Default": 60999,
      "MinValue": 1,
      "MaxValue": 65535
    },
    "UbuntuImage": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned Ubuntu AMI; resolved once when the host is created"
    },
    "LobbyInstances": {
      "Type": "String",
      "Default": "",
      "Description": "Up to 16 comma-separated launch preset instance IDs; empty disables the web lobby"
    },
    "LobbyTokenHash": {
      "Type": "String",
      "Default": "",
      "NoEcho": true,
      "Description": "SHA-256 of the separate lobby invitation key"
    },
    "LobbyCodeKey": {
      "Type": "String",
      "Default": "",
      "Description": "Uploaded bootstrap ZIP key; set by aws lobby after initial provisioning"
    },
    "LobbyArchitecture": {
      "Type": "String",
      "Default": "arm64",
      "AllowedValues": [
        "arm64",
        "x86_64"
      ]
    },
    "LobbyHosts": {
      "Type": "String",
      "Default": ""
    },
    "LobbyHostResources": {
      "Type": "String",
      "Default": "arn:aws:ec2:us-east-1:000000000000:instance/not-configured"
    },
    "LobbyTableResources": {
      "Type": "String",
      "Default": "arn:aws:dynamodb:us-east-1:000000000000:table/not-configured"
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.73.0.0/24",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Internet": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "InternetAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "InternetGatewayId": {
          "Ref": "Internet"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "CidrBlock": "10.73.0.0/24"
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "InternetAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Internet"
        }
      }
    },
    "SubnetRoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Game host SSH and HTTPS from operator; game UDP",
        "VpcId": {
          "Ref": "Network"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "OperatorCIDR"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "CidrIp": {
              "Ref": "OperatorCIDR"
            }
          },
          {
            "IpProtocol": "udp",
            "FromPort": {
              "Ref": "UDPFrom"
            },
            "ToPort": {
              "Ref": "UDPTo"
            },
            "CidrIp": {
              "Ref": "GameCIDR"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": {
              "Ref": "UDPFrom"
            },
            "ToPort": {
              "Ref": "UDPTo"
            },
            "CidrIp": {
              "Ref": "GameCIDR"
            }
          }
        ]
      }
    },
    "SSHKey": {
      "Type": "AWS::EC2::KeyPair",
      "Properties": {
        "KeyName": {
          "Fn::Sub": "${AWS::StackName}-operator"
        },
        "PublicKeyMaterial": {
          "Ref": "PublicKey"
        }
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "SubnetRoutes"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "UbuntuImage"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "KeyName": {
          "Ref": "SSHKey"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "InstanceInitiatedShutdownBehavior": "stop",
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ],
            "DeleteOnTermination": true
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": {
                "Ref": "DiskGiB"
              },
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "insta-game:kind",
            "Value": "shared-host"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -eu\nssh-keygen -A\ncat > /usr/local/sbin/insta-game-ssh-key <<'KEYSCRIPT'\n#!/bin/sh\nprintf 'INSTA_GAME_SSH_HOST_KEY=%s\\n' \"$(cat /etc/ssh/ssh_host_ed25519_key.pub)\" > /dev/console\nKEYSCRIPT\nchmod 0755 /usr/local/sbin/insta-game-ssh-key\ncat > /etc/systemd/system/insta-game-ssh-key.service <<'KEYSERVICE'\n[Unit]\nDescription=Publish the SSH host identity to the authenticated EC2 console\nAfter=ssh.service\n[Service]\nType=oneshot\nExecStart=/usr/local/sbin/insta-game-ssh-key\n[Install]\nWantedBy=multi-user.target\nKEYSERVICE\nsystemctl daemon-reload\nsystemctl enable --now insta-game-ssh-key.service\ncat > /etc/systemd/system/insta-game-deadline.service <<'EOF'\n[Unit]\nDescription=Stop the game host after its maximum boot lifetime\n[Service]\nType=oneshot\nExecStart=/usr/bin/systemctl poweroff\nEOF\ncat > /etc/systemd/system/insta-game-deadline.timer <<'EOF'\n[Unit]\nDescription=Six hour game host cost limit\n[Timer]\nOnBootSec=6h\nAccuracySec=1min\nUnit=insta-game-deadline.service\n[Install]\nWantedBy=timers.target\nEOF\nsystemctl daemon-reload\nsystemctl enable --now insta-game-deadline.timer\n"
        },
        "IamInstanceProfile": {
          "Fn::If": [
            "HasLobby",
            {
              "Ref": "HostProfile"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "LobbyTable": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "HasLobby",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "LobbyCode": {
      "Type": "AWS::S3::Bucket",
      "Condition": "HasLobby",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbandonedUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasLobby",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "LobbyRequests",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Scan",
                    "dynamodb:PutItem",
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LobbyTable",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Condition": "HasLobby",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "LobbyRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasLobbyCode",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WakeSavedGames",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Scan",
                    "dynamodb:PutItem",
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::If": [
                      "HasFleet",
                      {
                        "Fn::Split": [
                          ",",
                          {
                            "Ref": "LobbyTableResources"
                          }
                        ]
                      },
                      {
                        "Fn::GetAtt": [
                          "LobbyTable",
                          "Arn"
                        ]
                      }
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:StartInstances"
                  ],
                  "Resource": {
                    "Fn::If": [
                      "HasFleet",
                      {
                        "Fn::Split": [
                          ",",
                          {
                            "Ref": "LobbyHostResources"
                          }
                        ]
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${Host}"
                      }
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-lobby:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "LobbyLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "HasLobbyCode",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-lobby"
        },
        "RetentionInDays": 3
      }
    },
    "LobbyFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasLobbyCode",
      "DependsOn": [
        "LobbyLogs"
      ],
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-lobby"
        },
        "Runtime": "provided.al2023",
        "Handler": "bootstrap",
        "Architectures": [
          {
            "Ref": "LobbyArchitecture"
          }
        ],
        "MemorySize": 128,
        "Timeout": 30,
        "ReservedConcurrentExecutions": 4,
        "Role": {
          "Fn::GetAtt": [
            "LobbyRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "LobbyCode"
          },
          "S3Key": {
            "Ref": "LobbyCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "INSTA_GAME_LOBBY_TABLE": {
              "Ref": "LobbyTable"
            },
            "INSTA_GAME_LOBBY_INSTANCES": {
              "Ref": "LobbyInstances"
            },
            "INSTA_GAME_LOBBY_TOKEN_HASH": {
              "Ref": "LobbyTokenHash"
            },
            "INSTA_GAME_HOST_ID": {
              "Ref": "Host"
            },
            "INSTA_GAME_STACK_ID": {
              "Ref": "AWS::StackId"
            },
            "INSTA_GAME_LOBBY_HOSTS": {
              "Ref": "LobbyHosts"
            }
          }
        }
      }
    },
    "LobbyURL": {
      "Type": "AWS::Lambda::Url",
      "Condition": "HasLobbyCode",
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {
          "Ref": "LobbyFunction"
        },
        "InvokeMode": "RESPONSE_STREAM"
      }
    },
    "LobbyURLPermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasLobbyCode",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "LobbyFunction"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "LobbyInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasLobbyCode",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "LobbyFunction"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "LobbyRetry": {
      "Type": "AWS::Events::Rule",
      "Condition": "HasLobbyCode",
      "Properties": {
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "RetryPendingStarts",
            "Arn": {
              "Fn::GetAtt": [
                "LobbyFunction",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 120,
              "MaximumRetryAttempts": 1
            }
          }
        ]
      }
    },
    "LobbyRetryPermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasLobbyCode",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "LobbyFunction"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "LobbyRetry",
            "Arn"
          ]
        }
      }
    }
  },
  "Outputs": {
    "InstanceID": {
      "Value": {
        "Ref": "Host"
      }
    },
    "LobbyTable": {
      "Condition": "HasLobby",
      "Value": {
        "Ref": "LobbyTable"
      }
    },
    "LobbyInstances": {
      "Condition": "HasLobby",
      "Value": {
        "Ref": "LobbyInstances"
      }
    },
    "LobbyCodeBucket": {
      "Condition": "HasLobby",
      "Value": {
        "Ref": "LobbyCode"
      }
    },
    "LobbyURL": {
      "Condition": "HasLobbyCode",
      "Value": {
        "Fn::GetAtt": [
          "LobbyURL",
          "FunctionUrl"
        ]
      }
    }
  },
  "Conditions": {
    "HasLobby": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "LobbyInstances"
            },
            ""
          ]
        }
      ]
    },
    "HasLobbyCode": {
      "Fn::And": [
        {
          "Condition": "HasLobby"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "LobbyCodeKey"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "HasFleet": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "LobbyHosts"
            },
            ""
          ]
        }
      ]
    }
  }
}
